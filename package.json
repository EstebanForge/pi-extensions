{
  "name": "@estebanforge/pi-hostname",
  "version": "1.0.0",
  "description": "Hostname indicator for Pi. Shows the machine hostname as the first item in the footer status line (bottom left), so you always know which box a session runs on across remote machines.",
  "keywords": [
    "pi-package",
    "pi-extension",
    "hostname",
    "status-bar",
    "footer"
  ],
  "license": "MIT",
  "author": {
    "name": "EstebanForge",
    "email": "esteban@actitude.cl",
    "url": "https://actitud.xyz"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EstebanForge/pi-hostname.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "files": [
    "extensions",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.87.0",
    "@earendil-works/pi-server": "^0.87.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.7"
  }
}
