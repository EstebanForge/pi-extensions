{
  "name": "@estebanforge/pi-extensions",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo for @estebanforge Pi Coding Agent extensions",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test",
    "prepublishOnly": "npm run check",
    "rel": "node scripts/release-pkg.mjs",
    "pub": "node scripts/publish-pkg.mjs",
    "release:patch": "node scripts/release.mjs patch",
    "release:minor": "node scripts/release.mjs minor",
    "release:major": "node scripts/release.mjs major",
    "publish": "npm run check && npm publish --workspaces"
  },
  "devDependencies": {
    "@colbymchenry/codegraph": "^1.0.1",
    "@earendil-works/pi-ai": "^0.87.0",
    "@earendil-works/pi-coding-agent": "^0.87.0",
    "@earendil-works/pi-server": "^0.87.0",
    "@earendil-works/pi-tui": "^0.87.0",
    "@rolldown/binding-wasm32-wasi": "^1.2.4",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typebox": "^1.3.4",
    "typescript": "^5.8.0",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EstebanForge/pi-extensions.git"
  }
}
