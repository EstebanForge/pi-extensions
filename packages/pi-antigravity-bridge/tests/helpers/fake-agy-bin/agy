#!/usr/bin/env bash
# Fake agy stream-json server. Reads one user line, then emits a reply whose
# agent_response frame is deliberately SPLIT across two stdout writes,
# simulating a pipe boundary landing mid-line.
read -r _line
case "$_line" in
  *STDERR-LEAK*)
    # Secret-bearing stderr crash (redaction tests): the exit path feeds
    # stderrTail straight into the turn-failure message.
    printf '%s\n' '{"event":"init","init":{"conversation_id":"conv-leak"}}'
    sleep 0.1
    echo 'boom google key AIzaSyA-1234567890abcdefghijklmnopqrstu' >&2
    exit 3
    ;;
  *HANG*)
    # Deterministic hang for mid-turn close tests: init, then never finish.
    printf '%s\n' '{"event":"init","init":{"conversation_id":"conv-hang"}}'
    sleep 30
    exit 0
    ;;
  *OVERFLOW-FLOOD*)
    # Frame-ceiling test: far more than the 32MB cap with no newline. The
    # driver's reassembly buffer must abort the turn instead of growing.
    # Exit on the write callback: a timer would race the parent's drain
    # speed and could kill the flood before the cap is reached.
    printf '%s\n' '{"event":"init","init":{"conversation_id":"conv-overflow"}}'
    node -e 'process.stdout.write("x".repeat(34*1024*1024), () => process.exit(0))'
    sleep 30
    exit 0
    ;;
  *NOISE-GLUE*)
    # Noise-guard test: the Chromium launcher line lands whole (dropped),
    # then a noise FRAGMENT without a newline glues onto the next real
    # frame (stripped, so the result frame still parses).
    printf '%s\n' '{"event":"init","init":{"conversation_id":"conv-noise"}}'
    sleep 0.1
    printf '%s\n' 'Opening in existing browser session.'
    printf '%s' 'Opening in existing browser session.'
    printf '%s\n' '{"event":"result","result":{"status":"SUCCESS","response":"AFTER-NOISE"}}'
    sleep 0.2
    exit 0
    ;;
esac
if [[ "$_line" == *KEEP-ALIVE* ]]; then
	# Two-turn reuse test: serve TWO user turns on ONE process, then exit.
	# The script-top read consumed turn 1's line; read turn 2's between the
	# replies so the driver sees a genuine persistent-process exchange.
	for _i in 1 2; do
		if [[ "$_i" -gt 1 ]]; then read -r _line; fi
		printf '%s\n' '{"event":"init","init":{"conversation_id":"conv-777"}}'
		sleep 0.15
		printf '%s\n' '{"event":"result","result":{"status":"SUCCESS","response":"KEEP-TURN"}}'
		sleep 0.1
	done
	exit 0
fi
printf '%s\n' '{"event":"init","init":{"conversation_id":"conv-777"}}'
sleep 0.15
printf '%s' '{"event":"step_update","step_update":{"step_index":1,"state":"DONE","step_type":"agent_response","text_delta":"HALF-ONE-'
sleep 0.25
printf '%s\n' 'HALF-TWO"}}'
sleep 0.15
printf '%s\n' '{"event":"result","result":{"status":"SUCCESS","response":"RESULT-BODY"}}'
sleep 0.2
