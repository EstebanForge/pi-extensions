{
  "name": "@estebanforge/pi-rtk-optimizer",
  "version": "1.0.1",
  "description": "RTK command rewriting and tool output compaction extension for the Pi coding agent. Rewrites bash commands to their rtk equivalents and compacts noisy tool output to reduce context window usage. (fork of MasuRii extension)",
  "keywords": [
    "pi-package",
    "pi-extension",
    "rtk",
    "token-optimization",
    "tool-compaction",
    "output-compaction",
    "command-rewrite"
  ],
  "license": "MIT",
  "author": {
    "name": "EstebanForge",
    "email": "esteban@actitude.cl",
    "url": "https://actitud.xyz"
  },
  "contributors": [
    {
      "name": "MasuRii",
      "url": "https://github.com/MasuRii"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EstebanForge/pi-extensions.git",
    "directory": "packages/pi-rtk-optimizer"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": "./extensions/index.ts"
  },
  "files": [
    "extensions",
    "lib",
    "config/config.example.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^1.0.0",
    "@earendil-works/pi-tui": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
