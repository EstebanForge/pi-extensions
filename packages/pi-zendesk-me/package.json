{
  "name": "@estebanforge/pi-zendesk-me",
  "version": "1.0.0",
  "description": "Zendesk Support read tools for Pi. Adds 7 LLM-callable tools (zendesk_*) that query the Zendesk Support API v2 over HTTPS: fetch a ticket (by id or agent URL), read the comment thread, search tickets, look up users and organizations, download attachments for viewing, and list tickets in a saved view (filter). OAuth client-credentials auth via ZENDESK_SUBDOMAIN / ZENDESK_CLIENT_ID / ZENDESK_CLIENT_SECRET - no API tokens (deprecated by Zendesk), no MCP server install.",
  "keywords": [
    "pi-package",
    "pi-extension",
    "zendesk",
    "support",
    "tickets",
    "rest-api",
    "coding-agent"
  ],
  "license": "MIT",
  "author": {
    "name": "EstebanForge",
    "email": "esteban@attitude.cl",
    "url": "https://actitud.xyz"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EstebanForge/pi-zendesk-me.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "files": [
    "extensions",
    "lib",
    "tests",
    "vitest.config.ts",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.87.0",
    "@earendil-works/pi-server": "^0.87.0",
    "@types/node": "^22.0.0",
    "typebox": "^1.3.4",
    "typescript": "^5.8.0",
    "vitest": "^4.1.7"
  }
}
