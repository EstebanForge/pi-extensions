{
  "name": "@estebanforge/pi-hostname",
  "version": "1.0.0",
  "description": "Hostname indicator for Pi. Shows the machine hostname as the first item in the footer status line (bottom left), so you always know which box a session runs on across remote machines.",
  "keywords": [
    "pi-package",
    "pi-extension",
    "hostname",
    "status-bar",
    "footer"
  ],
  "license": "MIT",
  "author": {
    "name": "EstebanForge",
    "email": "esteban@actitude.cl",
    "url": "https://actitud.xyz"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EstebanForge/pi-extensions.git",
    "directory": "packages/pi-hostname"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "files": [
    "extensions",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  }
}
